<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Salary Payslip</title>
    <style>
        @page {
            margin: 10mm 12mm;
            size: A4 portrait;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
            font-size: 11.5px;
            line-height: 1.4;
            margin: 0;
            padding: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        /* Header - Company Info */
        .header-table {
            width: 100%;
            margin-bottom: 12px;
            border-bottom: 2px solid #f27022;
            padding-bottom: 10px;
        }

        .logo {
            height: 55px;
            width: auto;
            object-fit: contain;
        }

        .company-info {
            text-align: right;
            vertical-align: middle;
        }

        .company-name {
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .company-address {
            font-size: 10px;
            color: #64748b;
            margin-top: 2px;
        }

        /* Title */
        .title {
            text-align: center;
            margin: 12px 0 16px;
        }

        .title h1 {
            font-size: 18px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #0f172a;
            margin: 0 0 4px 0;
        }

        .title .month {
            font-size: 12px;
            font-weight: 600;
            color: #f27022;
        }

        /* Employee Table */
        .employee-table {
            width: 100%;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            margin-bottom: 16px;
            background-color: #f8fafc;
        }

        .employee-table td {
            padding: 6px 10px;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
            width: 33.33%;
            font-size: 11px;
        }

        .employee-table td strong {
            color: #334155;
        }

        /* Salary Table */
        .salary-table {
            width: 100%;
            border: 1px solid #cbd5e1;
            margin-bottom: 16px;
        }

        .salary-table th {
            background: #0f172a;
            color: #ffffff;
            padding: 7px 10px;
            text-align: left;
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .salary-table td {
            padding: 7px 10px;
            border: 1px solid #e2e8f0;
            font-size: 11px;
        }

        .amount-col {
            text-align: right;
            width: 120px;
        }

        .total-row {
            background: #f1f5f9;
            font-weight: 700;
            color: #0f172a;
        }

        .total-row td {
            border-top: 2px solid #cbd5e1;
        }

        /* Net Pay Box */
        .net-pay-box {
            margin-top: 16px;
            text-align: center;
        }

        .net-inner {
            display: block;
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 4px;
            border-left: 5px solid #f27022;
            text-align: center;
        }

        .net-value {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .net-words {
            font-size: 11px;
            color: #cbd5e1;
            margin-top: 3px;
            font-style: italic;
        }

        /* Signatures */
        .signature-table {
            width: 100%;
            margin-top: 50px;
            text-align: center;
        }

        .sig-line {
            border-top: 1px solid #94a3b8;
            width: 70%;
            margin: 0 auto 8px auto;
        }

        .sig-title {
            font-weight: 700;
            color: #0f172a;
            font-size: 11px;
        }

        .sig-sub {
            font-size: 10px;
            color: #64748b;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <table class="header-table">
        <tr>
            <td style="width: 50%;">
                <img src="<%= logo %>" alt="Viral Ads Media" class="logo">
            </td>
            <td class="company-info">
                <div class="company-name">VIRAL ADS MEDIA</div>
                <div class="company-address">
                    B-27, Budh Vihar Phase 1, New Delhi-110086
                </div>
            </td>
        </tr>
    </table>

    <!-- Title -->
    <div class="title">
        <h1>SALARY PAYSLIP</h1>
        <div class="month">For the month of <%= payMonth || '—' %></div>
    </div>

    <!-- Employee Information -->
    <table class="employee-table">
        <tr>
            <td><strong>Employee Name:</strong> <%= employeeName || '—' %></td>
            <td><strong>Emp ID:</strong> <%= employeeId || '—' %></td>
            <td><strong>Designation:</strong> <%= designation || '—' %></td>
        </tr>
        <tr>
            <td><strong>DOJ:</strong> <%= joiningDate || '—' %></td>
            <td><strong>PAN No:</strong> <%= panNumber || '—' %></td>
            <td><strong>Aadhaar No:</strong> <%= aadharNumber || '—' %></td>
        </tr>
        <tr>
            <td><strong>Bank A/c No:</strong> <%= bankAccount || '—' %></td>
            <td><strong>IFSC Code:</strong> <%= ifsc || '—' %></td>
            <td><strong>Phone:</strong> <%= phone || '—' %></td>
        </tr>
        <tr>
            <td><strong>NOD (No. of Days):</strong> <%= workingDays || 30 %></td>
            <td><strong>NDP (Days Present):</strong> <%= (Number(workingDays || 30) - Number(lopDays || 0)) %></td>
            <td><strong>LOP Days:</strong> <%= lopDays || 0 %></td>
        </tr>
    </table>

    <!-- Salary Table -->
    <table class="salary-table">
        <thead>
            <tr>
                <th>Earnings</th>
                <th class="amount-col">Amount (₹)</th>
                <th>Deductions</th>
                <th class="amount-col">Amount (₹)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Basic Salary</td>
                <td class="amount-col"><%= basicSalary || '0' %></td>
                <td>Loss of Pay (LOP)</td>
                <td class="amount-col"><%= lopAmount || '0' %></td>
            </tr>
            <tr>
                <td>Allowance</td>
                <td class="amount-col"><%= allowance || '0' %></td>
                <td>Other Deduction</td>
                <td class="amount-col"><%= otherDeduction || '0' %></td>
            </tr>
            <tr>
                <td>Bonus</td>
                <td class="amount-col"><%= bonus || '0' %></td>
                <td></td>
                <td class="amount-col"></td>
            </tr>
            <tr class="total-row">
                <td>Gross Earnings</td>
                <td class="amount-col">₹<%= grossEarnings || '0' %></td>
                <td>Total Deductions</td>
                <td class="amount-col">₹<%= totalDeductions || '0' %></td>
            </tr>
        </tbody>
    </table>

    <!-- Net Pay Box -->
    <div class="net-pay-box">
        <div class="net-inner">
            <div class="net-value">Net Pay: ₹ <%= netPayable || '0' %></div>
            <div class="net-words">(Rupees <%= netPayWords || '0' %> Only)</div>
        </div>
    </div>

    <!-- Signatures -->
    <table class="signature-table">
        <tr>
           
            <td style="width: 50%;">
                <div class="sig-line"></div>
                <div class="sig-title">Authorised Signatory</div>
                <div class="sig-sub">For Viral Ads Media</div>
            </td>
        </tr>
    </table>

</body>

</html>