<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Full & Final Settlement Statement</title>
    <style>
        @page {
            margin: 12mm 15mm;
            size: A4 portrait;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            color: #1e293b; 
            line-height: 1.5; 
            font-size: 12px; 
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        /* Header Styling matching Viral Ads Media */
        .header-table {
            width: 100%;
            border-bottom: 3px solid #f27022;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        .logo { 
            height: 55px; 
            width: auto;
            object-fit: contain;
        }

        .statement-label {
            text-align: right;
            vertical-align: bottom;
        }

        .statement-title {
            font-size: 20px;
            font-weight: 700;
            color: #f27022;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 4px 0;
        }

        .statement-date {
            font-size: 11px;
            color: #64748b;
            font-weight: 500;
        }

        /* Employee Info Grid */
        .info-section {
            width: 100%;
            margin-bottom: 20px;
            border-collapse: collapse;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
        }

        .info-cell {
            width: 50%;
            padding: 12px 16px;
            vertical-align: top;
            line-height: 1.8;
        }

        .label { 
            font-weight: 600; 
            color: #475569; 
            width: 120px; 
            display: inline-block; 
        }

        /* Settlement Table */
        .settlement-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0 15px 0;
            border: 1px solid #cbd5e1;
        }

        .settlement-table th {
            background-color: #f27022;
            color: #ffffff;
            text-align: left;
            padding: 10px 14px;
            text-transform: uppercase;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .settlement-table td {
            padding: 10px 14px;
            border-bottom: 1px solid #e2e8f0;
            border-right: 1px solid #e2e8f0;
            font-size: 12px;
        }

        .amount-col { 
            text-align: right; 
            font-family: 'Courier New', Courier, monospace; 
            font-weight: 700; 
            width: 160px;
        }

        .net-payable-row {
            background-color: #fff5f0;
            font-size: 15px;
            font-weight: 700;
        }

        .net-payable-row td {
            color: #f27022;
            border-top: 2px solid #f27022;
            border-bottom: 2px solid #f27022;
            padding: 12px 14px;
        }

        /* Signatures */
        .signature-section {
            margin-top: 60px;
            width: 100%;
            border-collapse: collapse;
        }

        .sig-box {
            width: 42%;
            padding-top: 12px;
            border-top: 1px solid #94a3b8;
            text-align: center;
            font-size: 11px;
            color: #334155;
            line-height: 1.4;
        }

        .footer {
            margin-top: 50px;
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
        }

        .bank-details {
            margin-top: 15px;
            font-size: 12px;
            color: #444;
        }
    </style>
</head>
<body>

    <table class="header-table">
        <tr>
            <td style="width: 50%;">
                <img src="<%= logo %>" class="logo" alt="Viral Ads Media"> 
            </td>
            <td class="statement-label">
                <div class="statement-title">Full & Final Statement</div> 
                <span class="statement-date">Date of Issue: <%= currentDate %></span>
            </td>
        </tr>
    </table>

    <table class="info-section">
        <tr>
            <td class="info-cell">
                <span class="label">Employee Name:</span> <strong><%= employeeName %></strong><br> 
                <span class="label">Employee ID:</span> <%= typeof employeeId !== 'undefined' ? employeeId : 'N/A' %><br>
                <span class="label">Designation:</span> <%= typeof designation !== 'undefined' ? designation : 'Employee' %><br>
                <span class="label">Account No:</span> <%= typeof bankAccount !== 'undefined' ? bankAccount : 'N/A' %><br>
                <span class="label">Address:</span> <%= typeof address !== 'undefined' ? address : 'N/A' %>
            </td>
            <td class="info-cell">
                <span class="label">Date of Joining:</span> <%= dateOfJoining %><br> 
                <span class="label">Last Working Day:</span> <%= lastWorkingDay %><br> 
                <span class="label">Contact:</span> <%= phone %><br>
                <span class="label">IFSC:</span> <%= typeof ifsc !== 'undefined' ? ifsc : 'N/A' %><br>
                <span class="label">Email:</span> <%= email %>
            </td>
        </tr>
    </table>

    <table class="settlement-table">
        <thead>
            <tr>
                <th>Particulars</th> 
                <th style="text-align: right;">Amount (INR)</th> 
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pending Salary / Basic Pay</td>
                <td class="amount-col"><%= pendingSalary %></td> 
            </tr>
            <tr>
                <td>Leave Encashment</td>
                <td class="amount-col"><%= leaveEncashment %></td> 
            </tr>
            <tr>
                <td>Bonus / Performance Incentive</td>
                <td class="amount-col"><%= incentive %></td> 
            </tr>
            <tr>
                <td>Other Allowances</td>
                <td class="amount-col">0.00</td>
            </tr>
            <tr>
                <td style="color: #dc2626; font-weight: 600;">Deductions (TDS/LWP/Notice Recovery)</td>
                <td class="amount-col" style="color: #dc2626;">- <%= deductions %></td> 
            </tr>
            <tr class="net-payable-row">
                <td>NET PAYABLE AMOUNT</td> 
                <td class="amount-col">₹ <%= totalPayable %></td> 
            </tr>
        </tbody>
    </table>

    <p style="font-size: 11px; margin-top: 15px; font-style: italic; color: #64748b;">
        * This is a computer-generated statement. The net payable amount will be credited to your bank account registered with Viral Ads Media.
    </p>

    <table class="signature-section">
        <tr>
            <td class="sig-box">
                <strong>Prepared By</strong><br> 
                HR & Accounts Department<br>
                Viral Ads Media 
            </td>
            <td style="width: 16%;"></td>
            <td class="sig-box">
                <strong>Employee Acknowledgment</strong><br> 
                Name: <%= employeeName %> 
            </td>
        </tr>
    </table>

    <div class="footer">
        <strong>Viral Ads Media</strong> | Digital Creative Agency <br>
        <%= companyAddress %> 
    </div>

</body>
</html>